{
  "model": "claude-opus-5-5",
  "autoMode": {
    "classifyAllShell": true
  },
  "env": {
    "DOTNET_SYSTEM_NET_DISABLEIPV6": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git branch*)",
      "Bash(git remote*)",
      "Bash(git tag*)",
      "Bash(git describe*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git shortlog*)",
      "Bash(git stash list*)",
      "Bash(git config --get*)",
      "Bash(gh pr view*)",
      "Bash(gh issue view*)",
      "Bash(gh repo view*)",
      "Bash(docker ps*)",
      "Bash(docker images*)",
      "Bash(npm ls*)",
      "Bash(npm outdated*)",
      "Bash(brew list*)",
      "Bash(brew info*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/*_secret*)",
      "Read(**/*secrets*)",
      "Read(**/credentials.json)",
      "Read(**/credentials.yml)",
      "Read(**/*.credentials)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/.pgpass)",
      "Read(**/.git-credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gcloud/legacy_credentials/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pgpass)",
      "Read(~/.git-credentials)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.kube/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.netrc)",
      "Edit(~/.npmrc)",
      "Edit(~/.pgpass)",
      "Edit(~/.git-credentials)",
      "Edit(~/Library/Keychains/**)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.claude.json)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(mkfs*)",
      "Bash(dd if=/dev/zero*)",
      "Bash(dd if=/dev/random*)",
      "Bash(chmod -R 777 /)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git push * --delete*)",
      "Bash(git filter-branch*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune=now*)",
      "Bash(git stash clear*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(gh auth token*)",
      "Edit(//etc/**)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(npm publish*)",
      "Bash(npm unpublish*)",
      "Bash(kill -9*)",
      "Bash(killall*)",
      "Bash(chmod -R*)",
      "Bash(chmod 777*)",
      "Bash(chown -R*)",
      "Bash(diskutil eraseDisk*)",
      "Bash(defaults write*)",
      "Bash(defaults delete*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(eval *)",
      "Bash(crontab -r*)",
      "Bash(launchctl load*)",
      "Bash(launchctl unload*)",
      "Bash(terraform destroy*)",
      "Bash(kubectl delete*)",
      "Bash(docker system prune*)",
      "Bash(docker rm -f*)",
      "Bash(docker volume rm*)",
      "Bash(aws s3 rm*)",
      "Bash(aws ec2 terminate-instances*)",
      "Bash(gcloud * delete*)",
      "Bash(gh secret set*)",
      "Bash(gh secret delete*)",
      "Bash(gh auth logout*)",
      "Bash(gh pr merge*)",
      "Bash(gh workflow delete*)",
      "Bash(gh workflow disable*)"
    ],
    "defaultMode": "plan"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "docker",
      "docker-compose",
      "lazydocker",
      "colima",
      "nix"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache",
        "~/Library/pnpm",
        "~/.local/share/pnpm",
        "~/.nuget",
        "~/.config/gh",
        "~/.local/share/gh",
        "~/.local/state/gh"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.kube",
        "~/.docker/config.json",
        "~/.config/gh",
        "~/.config/gh-work",
        "~/.config/gcloud",
        "~/.netrc",
        "~/.pgpass",
        "~/.git-credentials",
        "~/.claude.json",
        "~/.claude-work/.claude.json",
        "~/.config/nixhome-local"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "cache.nixos.org",
        "api.nuget.org"
      ],
      "allowMachLookup": [
        "com.apple.SecurityServer"
      ]
    }
  }
}
