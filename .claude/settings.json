{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/*_secret*)",
      "Read(**/*secrets*)",
      "Read(**/credentials.json)",
      "Read(**/credentials.yml)",
      "Read(**/*.credentials)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/.pgpass)",

      "Read(//Users/colin/.ssh/**)",
      "Read(//Users/colin/.aws/**)",
      "Read(//Users/colin/.gnupg/**)",
      "Read(//Users/colin/.docker/config.json)",
      "Read(//Users/colin/.kube/**)",
      "Read(//Users/colin/.config/gh/**)",
      "Read(//Users/colin/.config/gcloud/**)",
      "Read(//Users/colin/.config/gcloud/legacy_credentials/**)",
      "Read(//Users/colin/.netrc)",
      "Read(//Users/colin/.npmrc)",
      "Read(//Users/colin/.pgpass)",
      "Read(//Users/colin/Library/Keychains/**)",
      "Read(//Users/colin/.claude/.credentials.json)",
      "Read(//Users/colin/.claude.json)",

      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(mkfs*)",
      "Bash(dd if=/dev/zero*)",
      "Bash(dd if=/dev/random*)",
      "Bash(chmod -R 777 /)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",

      "Edit(//etc/**)",
      "Write(//etc/**)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git *)",
      "Bash(npm publish*)",
      "Bash(kill -9*)",
      "Bash(killall*)",
      "Bash(chmod -R*)",
      "Bash(chown -R*)",
      "Bash(diskutil eraseDisk*)",
      "Bash(defaults write*)"
    ]
  }
}
