# Work profile, deployed by home-manager into the work repo and its worktree
# root (see `work` in home-manager/home.nix). Outside those trees the personal
# defaults (~/.claude, ~/.config/gh) apply.
export CLAUDE_CONFIG_DIR="$HOME/.claude-work"
export GH_CONFIG_DIR="$HOME/.config/gh-work"

# Machine-local variables such as GH_TOKEN, kept next to the deployed .envrc
# and out of this repo.
dotenv_if_exists .env.local
